NODE_ENV=development
PORT=5000
BEHIND_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://edzest.org,https://www.edzest.org
CLIENT_URL=http://localhost:3000
COOKIE_DOMAIN=

AWS_REGION=ap-south-1
S3_BUCKET=edzest-bucket
S3_SSE=AES256
STAGE=default
GW_BASE_PATH=/edzest-test-backend

# DynamoDB (your existing names)
MOCKTESTS_TABLE=MockTests
MOCKTESTS_GSI_SLUG=GSI_Slug
DDB_USERS_TABLE=EdzestUsers
DDB_INSTITUTES_TABLE=EdzestInstitutes
DDB_TABLE=edzest_lms
DDB_STUDENT_TEST_DATA=StudentTestData
DDB_USERS=Users
DDB_MOCK_TEST=MockTest
DDB_STU_ATTEMPTS=StudentMocktestAttempts
DDB_STU_DATA=StudentMocktestData
DDB_PK_ATTR=pk
DDB_SK_ATTR=sk
DEFAULT_INSTITUTE_ID=0z2w1ep
DEFAULT_INSTITUTE_NAME=Edzest
MOCKS_PREFIX=mocktests
DDB_ATTEMPTS_GSI=byInstituteUser

# Q-Bank / E-book
